{
  "name": "move-assets-tool",
  "version": "1.0.0",
  "description": "文件同步工具 - 將指定資料夾內容同步到 Cocos Creator 專案",
  "main": "move-assets.js",
  "scripts": {
    "start": "node move-assets.js",
    "sync": "node move-assets.js",
    "sync:2d": "node move-assets.js --type 2D", 
    "sync:3d": "node move-assets.js --type 3D",
    "help": "node move-assets.js --help",
    "cli": "node move-assets-cli.js"
  },
  "bin": {
    "move-assets-cli": "./move-assets-cli.js"
  },
  "engines": {
    "node": ">=18.20.6"
  },
  "keywords": [
    "file-sync",
    "cocos-creator",
    "assets"
  ],
  "author": "",
  "license": "MIT"
} 